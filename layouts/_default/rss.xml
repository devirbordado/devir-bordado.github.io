{{- $pages := slice -}}
{{- if .IsHome -}}
  {{- $pages = partial "novidades.html" . -}}
{{- else -}}
  {{- range .Pages -}}{{- if not .Date.IsZero -}}{{- $pages = $pages | append . -}}{{- end -}}{{- end -}}
  {{- $pages = sort $pages "Date" "desc" -}}
{{- end -}}
{{- $pages = first 30 $pages -}}
{{- $titulo := cond .IsHome (printf "%s — %s" (i18n "feed_novidades") site.Title) (printf "%s — %s" .Title site.Title) -}}
{{- $desc := cond .IsHome (i18n "desc") (or .Description (i18n "desc")) -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ $titulo }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ $desc }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    {{- with index $pages 0 }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType.Type | safeHTML }}
    {{- end }}
    {{- range $pages }}
    {{- /* Sem capa própria, usa a imagem da seção (a mesma dos cartões da Home), para o e-mail nunca ficar com imagem quebrada. */ -}}
    {{- $capa := or .Params.cover .Params.img (printf "/assets/images/home/%s.webp" .Type) }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <category>{{ i18n (cond (eq .Type "blog") "blogp" (cond (eq .Type "herbario") "herb" (cond (eq .Type "acervo") "acervo" "pub"))) }}</category>
      <guid>{{ .Permalink }}</guid>
      <description>{{ partial "feed-resumo.html" . }}</description>
      {{- if $capa }}
      {{- $ext := path.Ext $capa }}
      {{- $tipo := cond (eq $ext ".webp") "image/webp" (cond (eq $ext ".png") "image/png" "image/jpeg") }}
      {{- $tam := 0 }}{{ with (os.Stat (printf "static%s" $capa)) }}{{ $tam = .Size }}{{ end }}
      <enclosure url="{{ $capa | absURL }}" length="{{ $tam }}" type="{{ $tipo }}" />
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
